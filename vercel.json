{
  "version": 2,
  "builds": [
    {
      "src": "crm-backend/src/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "crm-frontend/package.json",
      "use": "@vercel/static-build"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "crm-backend/src/server.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "crm-frontend/dist/assets/$1"
    },
    {
      "src": "/icons/(.*)",
      "dest": "crm-frontend/dist/icons/$1"
    },
    {
      "src": "/(.*)\\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|webmanifest)",
      "dest": "crm-frontend/dist/$1.$2"
    },
    {
      "src": "/(.*)",
      "dest": "crm-frontend/dist/index.html"
    }
  ]
}