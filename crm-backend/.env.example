# ══════════════════════════════════════════
# باشگاه مشتریان پویا پلاستیک — Backend .env
# ══════════════════════════════════════════

NODE_ENV=development
PORT=4000
JWT_SECRET=your-jwt-secret-change-me
OTP_SECRET=use-a-different-long-random-secret
SEED_ADMIN_PASSWORD=change-this-before-seeding

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/pouya_loyalty

# Hepikal SMS
HEPIKAL_API_KEY=your-hepikal-api-key
HEPIKAL_BASE_URL=https://api.hepikal.com/v1
HEPIKAL_SENDER=3000XXXXX
HEPIKAL_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# Web Push VAPID
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@pooyaplastic.com

# اجرای تحلیل ریزش و انقضای امتیاز هر شب ساعت ۲
ENABLE_SCHEDULER=true

# CSAT
CSAT_BASE_URL=https://app.domain.com/csat

# CORS
FRONTEND_URL=http://localhost:3000
